# ============================================================================
# Giyim Reklam Otomasyonu - Ortam Degiskenleri (Environment Variables)
# Bu dosyayi .env.local olarak kopyalayip degerleri doldurun.
# NOT: Hicbir key olmadan da proje calisir (yerel JSON store + mock AI).
# ============================================================================

# --- Genel / Site ---
# Sitenin herkese acik adresi (sonunda slash olmadan)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sitenin adi (baslik, sosyal aciklamalar vs.)
NEXT_PUBLIC_SITE_NAME=ModaVitrin

# --- Admin Girisi ---
# Admin paneline giris icin sifre. Bos birakilirsa admin gelistirme modunda acik olur.
ADMIN_PASSWORD=degistir-bu-sifreyi
# Oturum cerezini imzalamak icin rastgele uzun bir string
ADMIN_SESSION_SECRET=rastgele-uzun-gizli-anahtar-buraya

# --- Supabase (opsiyonel; bos ise yerel JSON store kullanilir) ---
# Faz 1 icin gerekli degil. Production'da onerilir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Videolarin/gorsellerin yuklenecegi Storage bucket adi
SUPABASE_STORAGE_BUCKET=media

# --- Amazon Associates / PA-API (opsiyonel) ---
# Affiliate etiketiniz (orn. modavitrin-21)
AMAZON_ASSOCIATE_TAG=
# PA-API erisimi (Associates onayindan sonra). Bos ise linkten temel veri cikarilir.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_HOST=webservices.amazon.com.tr
AMAZON_PAAPI_REGION=eu-west-1

# --- AI: Metin uretimi (prompt + platform aciklamalari) ---
# OpenAI uyumlu bir saglayici. Bos ise sablon tabanli metin uretilir (mock).
# OpenAI: https://api.openai.com/v1  | Groq: https://api.groq.com/openai/v1
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- AI: Video uretimi (Luma Dream Machine) ---
# Bos ise mock video (orijinal gorsel) donulur.
LUMA_API_KEY=

# --- Analitik (Google Analytics 4, opsiyonel) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Reklam (Google AdSense, opsiyonel) ---
# ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Reklam bloklarinin slot ID'leri
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# --- Inngest (opsiyonel; async video pipeline) ---
# Bos ise pipeline generate cagrisinda inline calisir.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============================================================================
# YAYINLAMA (Faz 3) - Sosyal platform API anahtarlari (hepsi opsiyonel)
# Token yoksa panel "indir + kopyala" manuel modunu gosterir.
# ============================================================================

# --- Pinterest ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- YouTube (Google OAuth) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Meta (Instagram + Facebook Graph API) ---
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
